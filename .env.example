# Environment Configuration for Underwater Image Analysis API
# Copy this file to .env and adjust values as needed

# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Model Paths
ENHANCER_MODEL_PATH=models/enhancer_model.pth
SEACLEAR_MODEL_PATH=runs/seaclear/yolov11n_seaclear/weights/best.pt
AQUARIUM_MODEL_PATH=runs/dataa_yolov8/dataa_full_v8/train/weights/best.pt

# Multi-model and auto-discovery
USE_MULTI_MODEL=True
AUTO_DISCOVER_YOLO_MODELS=True
YOLO_MODEL_GLOB_PATTERNS=runs/**/weights/*.pt,models/*.pt,yolo11*.pt

# Optional Phi-4 multimodal verification (Ollama)
PHI4_ENABLED=False
PHI4_PROVIDER=ollama
PHI4_MODEL_NAME=phi4-multimodal
PHI4_OLLAMA_URL=http://localhost:11434/api/chat
PHI4_TIMEOUT_SECONDS=20.0
PHI4_VERIFY_MIN_CONFIDENCE=0.05
PHI4_VERIFY_MAX_CONFIDENCE=0.55
PHI4_MAX_CHECKS_PER_IMAGE=6
PHI4_BOX_PADDING=12

# Detection Settings
CONFIDENCE_THRESHOLD=0.5
NMS_THRESHOLD=0.45

# File Upload Settings
MAX_FILE_SIZE_MB=10.0
ALLOWED_EXTENSIONS=["jpg", "jpeg", "png", "bmp"]

# Static Files
STATIC_DIR=static

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Image Processing
ENHANCE_INPUT_SIZE=(256, 256)
